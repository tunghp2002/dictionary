{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "English to Vietnamese translation record",
  "type": "object",
  "additionalProperties": false,
  "required": ["sense_id", "meaning", "description", "examples", "collocations"],
  "properties": {
    "sense_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "meaning": {"type": "string"},
    "description": {"type": "string"},
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["en", "vi"],
        "properties": {
          "en": {"type": "string"},
          "vi": {"type": "string"}
        }
      }
    },
    "collocations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
